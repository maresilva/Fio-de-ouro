# ==============================================================================
# ERP Fio de Ouro - Configurações de Ambiente (Vite / Vercel)
# ==============================================================================
# Homologação e Produção devem possuir projetos dedicados e separados no Supabase.
# ATENÇÃO: Nunca insira chaves administrativas (service_role) neste arquivo!
# ==============================================================================

# URL pública da API do Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto-fio-de-ouro.supabase.co

# Chave pública anônima (anon key) do Supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ambiente (homologacao | producao)
VITE_APP_ENV=homologacao
